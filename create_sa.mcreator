  "workspaceSettings": {
    "modid": "create_sa",
    "modName": "Create Stuff \u0027N Additions",
    "version": "2.1.0.e",
    "description": "Create Stuff \u0026 Additions is a mod that uses the resources of Create to offer a new set of equipment, tools and gadget! Equipments that increase your physical abilities (Your Strength or Mining Speed) but also give you new ways to move, floating, bouncing and even flying! Depending on your type of equipment (brass, andesite or copper) you will need different fuels such as steam (using water and fuel), thermal energy (using fuel) or hydraulic energy (using water)! This mod also adds a lot of  recipes that make certain Minecraft items (Chainmail Armor, Coral, Netherrack, Crying Obsidian and Magma Cream...) craftable with the new ways added by Create such as haunting and filling!",
    "author": "Furti_Two",
    "websiteURL": "https://www.curseforge.com/minecraft/mc-mods/create-stuff-additions",
